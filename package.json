    "keybindings": [
      {
        "command": "surround.with",
        "key": "ctrl+shift+T",
        "mac": "cmd+shift+T",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "surround.with",
          "group": "1_modification"
        }
      ]
    }
